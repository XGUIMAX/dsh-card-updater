{
  "name": "dsh-card-updater",
  "version": "1.46.0",
  "description": "DSH Tavern 卡片更新器：按链接检测人物卡更新、更新原版卡，并把变更合并进 MVU 版卡。Card updater for DSH Tavern: diff remote cards by link, refresh the original, and merge into the MVU variant.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "install.ps1",
    "uninstall.ps1",
    "install.sh",
    "uninstall.sh",
    "PERMISSIONS.md",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XGUIMAX/dsh-card-updater.git"
  },
  "bugs": {
    "url": "https://github.com/XGUIMAX/dsh-card-updater/issues"
  },
  "homepage": "https://github.com/XGUIMAX/dsh-card-updater#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-tavern",
    "tavern",
    "character-card",
    "mvu",
    "card-updater"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.8 <0.2.0",
      "dshReleases": {
        "0.1.2-rc.1": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
